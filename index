<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wedding Invitation — Raymond & Joy</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --dusty-blush: #E8C5C8;
            --soft-pink: #F7EBEB;
            --mauve: #B58A94;
            --warm-ivory: #FDFBF7;
            --champagne-gold: #D4AF37;
            --champagne-gold-light: #F4E8C1;
            --deep-burgundy: #581825;
            --charcoal: #2C2C2C;
            --muted-gray: #777777;
            
            --font-serif: 'Cormorant Garamond', Georgia, serif;
            --font-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        /* Reset & Base Styles */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--warm-ivory);
            color: var(--charcoal);
            font-family: var(--font-sans);
            font-weight: 300;
            line-height: 1.7;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, .serif-font {
            font-family: var(--font-serif);
            font-weight: 600;
            color: var(--deep-burgundy);
        }

        a {
            color: var(--deep-burgundy);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        a:hover {
            color: var(--mauve);
        }

        /* ENVELOPE OVERLAY SECTION */
        #envelope-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: #3b0f18;
            background-image: radial-gradient(#581825 1px, transparent 1px);
            background-size: 20px 20px;
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 1s cubic-bezier(0.77, 0, 0.175, 1), visibility 1s;
        }

        #envelope-overlay.opened {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .envelope-wrapper {
            position: relative;
            width: 90%;
            max-width: 420px;
            height: 280px;
            background: var(--soft-pink);
            border-radius: 8px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            border: 1px solid var(--dusty-blush);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .envelope-wrapper:hover {
            transform: translateY(-5px);
        }

        .envelope-flap {
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 210px solid transparent;
            border-right: 210px solid transparent;
            border-top: 140px solid var(--dusty-blush);
            transform-origin: top;
            transition: transform 0.8s ease;
            z-index: 3;
        }

        @media (max-width: 450px) {
            .envelope-wrapper { height: 240px; }
            .envelope-flap {
                border-left-width: 50vw;
                border-right-width: 50vw;
                border-top-width: 120px;
            }
        }

        .wax-seal {
            position: relative;
            z-index: 4;
            width: 75px;
            height: 75px;
            background: radial-gradient(circle, #7a2233 0%, var(--deep-burgundy) 100%);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 6px 15px rgba(0,0,0,0.4), inset 0 2px 4px rgba(255,255,255,0.2);
            border: 2px solid var(--champagne-gold);
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .wax-seal:hover {
            transform: scale(1.08);
        }

        .seal-initials {
            font-family: var(--font-serif);
            color: var(--champagne-gold);
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
        }

        .tap-prompt {
            margin-top: 25px;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--deep-burgundy);
            font-weight: 500;
            z-index: 4;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }

        /* MAIN CONTENT LAYOUT */
        .main-container {
            max-width: 850px;
            margin: 0 auto;
            padding: 0 20px;
            background: var(--warm-ivory);
            box-shadow: 0 0 30px rgba(0,0,0,0.03);
        }

        section {
            padding: 80px 0;
            border-bottom: 1px solid rgba(232, 197, 200, 0.4);
            text-align: center;
        }

        section:last-of-type {
            border-bottom: none;
        }

        .section-title {
            font-size: 2.2rem;
            margin-bottom: 15px;
            letter-spacing: 1px;
            position: relative;
            display: inline-block;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 40px;
            height: 1px;
            background: var(--champagne-gold);
            margin: 12px auto 0 auto;
        }

        .subtitle {
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--mauve);
            margin-bottom: 10px;
        }

        /* HERO SECTION */
        .hero-section {
            padding-top: 100px;
            padding-bottom: 60px;
        }

        .hero-intro {
            font-family: var(--font-serif);
            font-style: italic;
            font-size: 1.3rem;
            color: var(--mauve);
            margin-bottom: 15px;
        }

        .hero-names {
            font-size: 3.5rem;
            line-height: 1.1;
            margin-bottom: 20px;
            color: var(--deep-burgundy);
        }

        .hero-date {
            font-size: 1.1rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--charcoal);
            font-weight: 400;
        }

        /* PHOTO CONTAINER */
        .photo-card {
            margin: 40px auto;
            max-width: 600px;
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(88, 24, 37, 0.08);
            border: 1px solid var(--dusty-blush);
            background: #fff;
            padding: 12px;
        }

        .photo-placeholder {
            width: 100%;
            height: 400px;
            background-color: var(--soft-pink);
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: var(--mauve);
            font-family: var(--font-serif);
            font-size: 1.1rem;
            border: 1px dashed var(--mauve);
        }

        .photo-placeholder p {
            padding: 0 20px;
            text-align: center;
        }

        /* COUNTDOWN SECTION */
        .timer-container {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
            flex-wrap: wrap;
        }

        .timer-box {
            background: #fff;
            border: 1px solid var(--dusty-blush);
            width: 90px;
            height: 90px;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        }

        .timer-number {
            font-family: var(--font-serif);
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--deep-burgundy);
            line-height: 1;
        }

        .timer-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted-gray);
            margin-top: 4px;
        }

        /* CALENDAR SECTION */
        .calendar-wrapper {
            max-width: 380px;
            margin: 30px auto 0 auto;
            background: #fff;
            padding: 25px;
            border-radius: 8px;
            border: 1px solid var(--dusty-blush);
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        }

        .calendar-header {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            color: var(--deep-burgundy);
            margin-bottom: 20px;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 8px;
            text-align: center;
            font-size: 0.85rem;
        }

        .calendar-day-head {
            font-weight: 600;
            color: var(--mauve);
            font-size: 0.75rem;
            padding-bottom: 8px;
        }

        .calendar-date {
            padding: 8px 0;
            border-radius: 50%;
            color: var(--charcoal);
        }

        .calendar-date.highlight {
            background-color: var(--deep-burgundy);
            color: var(--warm-ivory);
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(88, 24, 37, 0.3);
        }

        /* VENUE SECTIONS */
        .venue-card {
            margin-top: 30px;
            background: #fff;
            padding: 30px;
            border-radius: 8px;
            border: 1px solid var(--dusty-blush);
        }

        .venue-name {
            font-size: 1.6rem;
            color: var(--deep-burgundy);
            margin-bottom: 8px;
        }

        .venue-address {
            font-size: 0.95rem;
            color: var(--muted-gray);
            margin-bottom: 20px;
        }

        .btn-link {
            display: inline-block;
            padding: 10px 24px;
            border: 1px solid var(--champagne-gold);
            color: var(--deep-burgundy);
            background: var(--warm-ivory);
            border-radius: 30px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-link:hover {
            background: var(--champagne-gold);
            color: #fff;
        }

        /* VINYL PLAYER SECTION */
        .vinyl-container {
            margin: 30px auto;
            position: relative;
            width: 180px;
            height: 180px;
            cursor: pointer;
        }

        .record {
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, #111 30%, #222 50%, #111 70%);
            border-radius: 50%;
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            display: flex;
            justify-content: center;
            align-items: center;
            animation: spin 8s linear infinite;
            animation-play-state: paused;
        }

        .vinyl-container:hover .record, .record.playing {
            animation-play-state: running;
        }

        @keyframes spin {
            100% { transform: rotate(360deg); }
        }

        .record-label {
            width: 65px;
            height: 65px;
            background: var(--soft-pink);
            border: 2px solid var(--champagne-gold);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: var(--font-serif);
            font-weight: 700;
            color: var(--deep-burgundy);
            font-size: 0.9rem;
        }

        .music-player-box {
            margin-top: 25px;
            max-width: 100%;
            overflow: hidden;
            border-radius: 12px;
        }

        /* DRESS CODE SECTION */
        .palette-container {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        .swatch-item {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .swatch-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            box-shadow: 0 3px 8px rgba(0,0,0,0.1);
            border: 2px solid #fff;
        }

        .swatch-name {
            font-size: 0.75rem;
            margin-top: 8px;
            color: var(--muted-gray);
            text-transform: capitalize;
        }

        /* GIFT NOTE SECTION */
        .gift-box {
            background: #fff;
            padding: 35px 25px;
            border-radius: 8px;
            border: 1px solid var(--dusty-blush);
            max-width: 600px;
            margin: 20px auto 0 auto;
            font-family: var(--font-serif);
            font-size: 1.15rem;
            font-style: italic;
            color: var(--charcoal);
        }

        /* RSVP SECTION */
        .rsvp-form {
            max-width: 550px;
            margin: 30px auto 0 auto;
            text-align: left;
            background: #fff;
            padding: 35px;
            border-radius: 8px;
            border: 1px solid var(--dusty-blush);
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
            color: var(--deep-burgundy);
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--dusty-blush);
            border-radius: 4px;
            font-family: var(--font-sans);
            font-size: 0.95rem;
            background: var(--warm-ivory);
            color: var(--charcoal);
            transition: border-color 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--mauve);
        }

        .radio-group {
            display: flex;
            gap: 20px;
            margin-top: 8px;
        }

        .radio-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.95rem;
            cursor: pointer;
            text-transform: none;
            letter-spacing: 0;
            font-weight: normal;
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: var(--deep-burgundy);
            color: #fff;
            border: none;
            border-radius: 4px;
            font-family: var(--font-sans);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .btn-submit:hover {
            background: #3b0f18;
        }

        .form-status {
            margin-top: 15px;
            padding: 12px;
            border-radius: 4px;
            font-size: 0.9rem;
            display: none;
            text-align: center;
        }

        .form-status.success {
            background-color: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #c8e6c9;
            display: block;
        }

        .form-status.error {
            background-color: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
            display: block;
        }

        /* HASHTAG SECTION */
        .hashtag-box {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            background: #fff;
            padding: 12px 24px;
            border-radius: 30px;
            border: 1px solid var(--dusty-blush);
            margin-top: 20px;
        }

        .hashtag-text {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            color: var(--deep-burgundy);
            font-weight: 700;
        }

        .btn-copy {
            background: none;
            border: none;
            color: var(--mauve);
            cursor: pointer;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: underline;
        }

        /* FOOTER */
        footer {
            padding: 60px 0;
            text-align: center;
            background: var(--soft-pink);
        }

        .footer-names {
            font-size: 2.2rem;
            color: var(--deep-burgundy);
            margin-bottom: 8px;
        }

        .footer-date {
            font-size: 0.9rem;
            letter-spacing: 2px;
            color: var(--muted-gray);
            text-transform: uppercase;
        }

        /* Accessibility: Reduced Motion */
        @media (prefers-reduced-motion: reduce) {
            #envelope-overlay { transition: none; }
            .envelope-flap { transition: none; }
            .record { animation: none; }
            .tap-prompt { animation: none; }
        }
    </style>
</head>
<body>

    <!-- A. INTERACTIVE ENVELOPE OVERLAY -->
    <div id="envelope-overlay" aria-label="Interactive Envelope Invitation">
        <div class="envelope-wrapper" id="envelope-card" onclick="openEnvelope()" role="button" tabindex="0" aria-label="Open Invitation Envelope">
            <div class="envelope-flap" id="envelope-flap"></div>
            <div class="wax-seal">
                <span class="seal-initials">R & J</span>
            </div>
            <div class="tap-prompt">Tap to Open</div>
        </div>
    </div>

    <!-- MAIN WEBSITE CONTENT -->
    <div class="main-container">

        <!-- B. HERO SECTION -->
        <section class="hero-section">
            <div class="subtitle">Together with their families</div>
            <h1 class="hero-names">Raymond & Joy</h1>
            <div class="hero-intro">invite you to celebrate their wedding day</div>
            <div class="hero-date">December 19, 2026</div>

            <!-- C. COUPLE PHOTOGRAPH -->
            <div class="photo-card">
                <!-- PHOTO PLACEHOLDER: Replace background-image with 'images/couple.jpg' once available -->
                <div class="photo-placeholder" id="couple-photo-placeholder" style="background-image: url('images/couple.jpg');">
                    <p><em>Couple Studio Portrait</em><br><small>(Add couple.jpg to images/ directory)</small></p>
                </div>
            </div>
        </section>

        <!-- D. LIVE WEDDING COUNTDOWN -->
        <section>
            <div class="subtitle">Counting Down To Our Forever</div>
            <h2 class="section-title">The Countdown</h2>
            <div class="timer-container" id="countdown-timer">
                <div class="timer-box"><span class="timer-number" id="days">00</span><span class="timer-label">Days</span></div>
                <div class="timer-box"><span class="timer-number" id="hours">00</span><span class="timer-label">Hours</span></div>
                <div class="timer-box"><span class="timer-number" id="minutes">00</span><span class="timer-label">Minutes</span></div>
                <div class="timer-box"><span class="timer-number" id="seconds">00</span><span class="timer-label">Seconds</span></div>
            </div>
            <div id="countdown-message" style="display:none; margin-top:20px; font-family: var(--font-serif); font-size:1.4rem; color: var(--deep-burgundy);">Today is the Day!</div>
        </section>

        <!-- E. DECEMBER 2026 CALENDAR -->
        <section>
            <div class="subtitle">Save The Date</div>
            <h2 class="section-title">December 2026</h2>
            <div class="calendar-wrapper">
                <div class="calendar-header">December 2026</div>
                <div class="calendar-grid">
                    <div class="calendar-day-head">Sun</div>
                    <div class="calendar-day-head">Mon</div>
                    <div class="calendar-day-head">Tue</div>
                    <div class="calendar-day-head">Wed</div>
                    <div class="calendar-day-head">Thu</div>
                    <div class="calendar-day-head">Fri</div>
                    <div class="calendar-day-head">Sat</div>

                    <!-- Offset for Dec 1, 2026 (Tuesday) -->
                    <div></div><div></div>

                    <div class="calendar-date">1</div>
                    <div class="calendar-date">2</div>
                    <div class="calendar-date">3</div>
                    <div class="calendar-date">4</div>
                    <div class="calendar-date">5</div>
                    <div class="calendar-date">6</div>
                    <div class="calendar-date">7</div>
                    <div class="calendar-date">8</div>
                    <div class="calendar-date">9</div>
                    <div class="calendar-date">10</div>
                    <div class="calendar-date">11</div>
                    <div class="calendar-date">12</div>
                    <div class="calendar-date">13</div>
                    <div class="calendar-date">14</div>
                    <div class="calendar-date">15</div>
                    <div class="calendar-date">16</div>
                    <div class="calendar-date">17</div>
                    <div class="calendar-date">18</div>
                    <div class="calendar-date highlight">19</div>
                    <div class="calendar-date">20</div>
                    <div class="calendar-date">21</div>
                    <div class="calendar-date">22</div>
                    <div class="calendar-date">23</div>
                    <div class="calendar-date">24</div>
                    <div class="calendar-date">25</div>
                    <div class="calendar-date">26</div>
                    <div class="calendar-date">27</div>
                    <div class="calendar-date">28</div>
                    <div class="calendar-date">29</div>
                    <div class="calendar-date">30</div>
                    <div class="calendar-date">31</div>
                </div>
            </div>
        </section>

        <!-- F. CEREMONY SECTION -->
        <section>
            <div class="subtitle">Where We Say I Do</div>
            <h2 class="section-title">The Ceremony</h2>
            <div class="photo-card" style="max-width: 500px;">
                <div class="photo-placeholder" style="height: 250px; background-image: url('images/chapel.jpg');">
                    <p><em>The Good Shepherd Chapel</em><br><small>(Add chapel.jpg to images/ directory)</small></p>
                </div>
            </div>
            <div class="venue-card">
                <div class="venue-name">The Good Shepherd Chapel</div>
                <div class="venue-address">San Isidro Village, Virac, Catanduanes, Philippines</div>
                <div style="font-weight: 500; color: var(--mauve); margin-bottom: 20px;">Saturday, December 19, 2026 · 2:00 PM (PST)</div>
                <a href="https://www.google.com/maps/search/?api=1&query=The+Good+Shepherd+Chapel+San+Isidro+Village+Virac+Catanduanes" target="_blank" rel="noopener noreferrer" class="btn-link">Get Directions</a>
            </div>
        </section>

        <!-- G. RECEPTION SECTION -->
        <section>
            <div class="subtitle">Time To Celebrate</div>
            <h2 class="section-title">The Reception</h2>
            <div class="photo-card" style="max-width: 500px;">
                <div class="photo-placeholder" style="height: 250px; background-image: url('images/reception.jpg');">
                    <p><em>The Lumber Hotel & Resort</em><br><small>(Add reception.jpg to images/ directory)</small></p>
                </div>
            </div>
            <div class="venue-card">
                <div class="venue-name">The Lumber Hotel & Resort</div>
                <div class="venue-address">Ibong Sapa, Virac, Catanduanes, Philippines</div>
                <div style="font-style: italic; color: var(--muted-gray); margin-bottom: 20px;">Reception time to be announced</div>
                <a href="https://www.google.com/maps/search/?api=1&query=The+Lumber+Hotel+%26+Resort+Ibong+Sapa+Virac+Catanduanes" target="_blank" rel="noopener noreferrer" class="btn-link">Get Directions</a>
            </div>
        </section>

        <!-- H. VINYL RECORD MUSIC PLAYER -->
        <section>
            <div class="subtitle">Our Song</div>
            <h2 class="section-title">Music Player</h2>
            <p style="font-size: 0.9rem; color: var(--muted-gray);">Tap the vinyl record to toggle the music player</p>
            
            <div class="vinyl-container" onclick="toggleMusicPlayer()">
                <div class="record" id="vinyl-record">
                    <div class="record-label">R & J</div>
                </div>
            </div>

            <div class="music-player-box" id="music-player-wrapper">
                <iframe style="border-radius:12px" src="https://open.spotify.com/embed/track/1fzAuUVbzlhZ1lJAx9PtY6?utm_source=generator&theme=0" width="100%" height="152" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
                <div style="margin-top: 10px; font-size: 0.8rem; color: var(--muted-gray);">
                    Alternative: <a href="https://www.youtube.com/watch?v=u9raS7-NisU" target="_blank" rel="noopener">Listen on YouTube</a>
                </div>
            </div>
        </section>

        <!-- I. DRESS CODE -->
        <section>
            <div class="subtitle">Attire Guidelines</div>
            <h2 class="section-title">Dress Code</h2>
            <p style="margin-top: 10px; font-size: 0.95rem; color: var(--charcoal);">We kindly request our guests to dress in formal attire following our wedding palette:</p>
            
            <div class="palette-container">
                <div class="swatch-item">
                    <div class="swatch-circle" style="background: #E8C5C8;"></div>
                    <span class="swatch-name">Dusty Blush</span>
                </div>
                <div class="swatch-item">
                    <div class="swatch-circle" style="background: #F7EBEB;"></div>
                    <span class="swatch-name">Soft Pink</span>
                </div>
                <div class="swatch-item">
                    <div class="swatch-circle" style="background: #B58A94;"></div>
                    <span class="swatch-name">Mauve</span>
                </div>
                <div class="swatch-item">
                    <div class="swatch-circle" style="background: #FDFBF7;"></div>
                    <span class="swatch-name">Warm Ivory</span>
                </div>
                <div class="swatch-item">
                    <div class="swatch-circle" style="background: #D4AF37;"></div>
                    <span class="swatch-name">Champagne</span>
                </div>
                <div class="swatch-item">
                    <div class="swatch-circle" style="background: #581825;"></div>
                    <span class="swatch-name">Burgundy</span>
                </div>
            </div>
        </section>

        <!-- J. GIFT NOTE -->
        <section>
            <div class="subtitle">With Love & Gratitude</div>
            <h2 class="section-title">Gift Note</h2>
            <div class="gift-box">
                "Your presence at our wedding is the greatest gift of all. Should you wish to honor us with a gift, a warm blessing or a monetary contribution towards our future together would be sincerely appreciated."
            </div>
        </section>

        <!-- K. RSVP SECTION -->
        <section>
            <div class="subtitle">Kindly Respond</div>
            <h2 class="section-title">RSVP</h2>
            <p style="font-size: 0.9rem; color: var(--muted-gray);">Please let us know if you can join us by responding below.</p>

            <form class="rsvp-form" id="rsvp-form" action="https://formsubmit.co/karenjoyaaquino@gmail.com" method="POST">
                <!-- FormSubmit Configuration -->
                <input type="hidden" name="_subject" value="Wedding RSVP — Raymond & Joy">
                <input type="hidden" name="_template" value="table">
                <input type="hidden" name="_captcha" value="false">

                <div class="form-group">
                    <label for="full-name">Full Name *</label>
                    <input type="text" id="full-name" name="Full Name" class="form-control" required placeholder="Enter your full name">
                </div>

                <div class="form-group">
                    <label>Attendance *</label>
                    <div class="radio-group">
                        <label class="radio-label">
                            <input type="radio" name="Attendance" value="Joyfully Accepts" required onclick="toggleGuests(true)"> Joyfully Accepts
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="Attendance" value="Regretfully Declines" onclick="toggleGuests(false)"> Regretfully Declines
                        </label>
                    </div>
                </div>

                <div class="form-group" id="guests-group">
                    <label for="num-guests">Number of Attendees *</label>
                    <select id="num-guests" name="Number of Guests" class="form-control">
                        <option value="1">1 Person</option>
                        <option value="2">2 Persons</option>
                        <option value="3">3 Persons</option>
                        <option value="4">4 Persons</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="message">Message for the Couple</label>
                    <textarea id="message" name="Message" class="form-control" rows="4" placeholder="Share your warm wishes..."></textarea>
                </div>

                <button type="submit" class="btn-submit">Submit RSVP</button>
                <div class="form-status" id="form-status"></div>
            </form>
        </section>

        <!-- L. WEDDING HASHTAG -->
        <section>
            <div class="subtitle">Share The Joy</div>
            <h2 class="section-title">Official Hashtag</h2>
            <div class="hashtag-box">
                <span class="hashtag-text" id="hashtag-text">#RaymondAndJoy</span>
                <button class="btn-copy" onclick="copyHashtag()">Copy</button>
            </div>
        </section>

        <!-- M. CLOSING SECTION -->
        <footer>
            <div class="footer-names">Raymond & Joy</div>
            <div class="footer-date">December 19, 2026 · Virac, Catanduanes</div>
        </footer>

    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // A. Interactive Envelope opening
        function openEnvelope() {
            const flap = document.getElementById('envelope-flap');
            const overlay = document.getElementById('envelope-overlay');
            
            flap.style.transform = 'rotateX(180deg)';
            
            setTimeout(() => {
                overlay.classList.add('opened');
            }, 600);
        }

        // D. Live Countdown Timer (Target: Dec 19, 2026 14:00:00 UTC+8)
        function updateCountdown() {
            // Target date in UTC+8
            const targetDate = new Date('2026-12-19T14:00:00+08:00').getTime();
            const now = new Date().getTime();
            const difference = targetDate - now;

            if (difference <= 0) {
                document.getElementById('countdown-timer').style.display = 'none';
                document.getElementById('countdown-message').style.display = 'block';
                return;
            }

            const days = Math.floor(difference / (1000 * 60 * 60 * 24));
            const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((difference % (1000 * 60)) / 1000);

            document.getElementById('days').textContent = String(days).padStart(2, '0');
            document.getElementById('hours').textContent = String(hours).padStart(2, '0');
            document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
            document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // H. Vinyl Record Interaction
        function toggleMusicPlayer() {
            const record = document.getElementById('vinyl-record');
            record.classList.toggle('playing');
        }

        // K. RSVP Form Logic (Require guests count only if attending)
        function toggleGuests(isAttending) {
            const guestsGroup = document.getElementById('guests-group');
            const guestsSelect = document.getElementById('num-guests');
            if (isAttending) {
                guestsGroup.style.display = 'block';
                guestsSelect.required = true;
            } else {
                guestsGroup.style.display = 'none';
                guestsSelect.required = false;
                guestsSelect.value = "0";
            }
        }

        // Form Submit Handler
        const rsvpForm = document.getElementById('rsvp-form');
        const formStatus = document.getElementById('form-status');

        rsvpForm.addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(rsvpForm);
            
            fetch(rsvpForm.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            }).then(response => {
                if (response.ok) {
                    formStatus.className = 'form-status success';
                    formStatus.textContent = 'Thank you! Your RSVP has been submitted successfully.';
                    rsvpForm.reset();
                } else {
                    throw new Error('Form submission failed.');
                }
            }).catch(error => {
                formStatus.className = 'form-status error';
                formStatus.textContent = 'Oops! There was a problem submitting your response. Please try again.';
            });
        });

        // L. Hashtag Copy Button
        function copyHashtag() {
            const hashtagText = document.getElementById('hashtag-text').innerText;
            navigator.clipboard.writeText(hashtagText).then(() => {
                alert('Hashtag copied to clipboard!');
            });
        }
    </script>
</body>
</html>
